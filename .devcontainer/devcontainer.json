{
  "name": "Smart Wrocław",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/smart_wroclaw",
  // Bring the whole stack up with the container, not just `app`.
  "runServices": ["app", "db", "inngest", "label-studio"],
  "remoteUser": "vscode",
  // Keep the service's `sleep infinity` command instead of overriding it.
  "overrideCommand": false,

  // Host access to in-network services. VS Code assigns free host ports and
  // lists them in the Ports panel — nothing is hard-bound, so no OS/port clashes.
  "forwardPorts": [3100, 8101, "inngest:8288", "label-studio:8080", "db:5432"],
  "portsAttributes": {
    "3100": { "label": "UI · Next.js", "onAutoForward": "notify" },
    "8101": { "label": "API + Inngest worker · FastAPI" },
    "8288": { "label": "Inngest dev dashboard" },
    "8080": { "label": "Label Studio" },
    "5432": { "label": "Postgres" }
  },

  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-python.flake8",
        "ms-python.mypy-type-checker",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/smart_wroclaw/.venv/bin/python"
      }
    }
  }
}
