# Template — copy to `api/.env` and fill in the values (`.env` is gitignored).
# CONFIG__-prefixed, nested with `__` (see smart_wroclaw/config.py). These same
# CONFIG__POSTGRES__* values are read by docker compose to provision the db.

# --- Postgres (required) ---
# HOST/PORT target the compose Postgres published on localhost:5439. The
# migrations container overrides HOST=db PORT=5432 to reach it inside the network.
CONFIG__POSTGRES__HOST=localhost
CONFIG__POSTGRES__PORT=5439
CONFIG__POSTGRES__DB=smart_wroclaw
CONFIG__POSTGRES__USER=smart_wroclaw
CONFIG__POSTGRES__PASSWORD=smart_wroclaw

# --- OpenAI (optional — without a key the agents use offline fallbacks) ---
CONFIG__OPENAI__API_KEY=
CONFIG__OPENAI__DEFAULT_MODEL_NAME=gpt-5.4

# --- Auth (email + password login, JWT). CHANGE THE SECRET/PEPPER in prod! ---
CONFIG__APP__JWT_SECRET=dev-insecure-change-me-please-min-32-bytes-secret
CONFIG__APP__PASSWORD_PEPPER=dev-pepper
# Public origin of the citizen UI — email confirmation / reset links point here.
CONFIG__APP__UI_BASE_URL=http://localhost:3100

# --- Resend email (optional — leave API_KEY empty to log links to the console) ---
# Get a key at https://resend.com. Without it, confirmation/reset links are
# printed to the API logs so the flow still works end-to-end in local dev.
CONFIG__RESEND__API_KEY=
CONFIG__RESEND__FROM_EMAIL=Smart Wrocław <onboarding@resend.dev>

# --- Misc ---
CONFIG__ENABLE_QUERY_LOGGING=false

# HERE.com — get credentials at https://platform.here.com
CONFIG__HERE__APP_ID=your-here-app-id
CONFIG__HERE__API_KEY=your-here-api-key
